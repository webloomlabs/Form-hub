# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Local dev runs Postgres on 5433 (5432 is often taken by other projects).
DATABASE_URL="postgresql://formhub:formhub@localhost:5433/formhub?schema=public"

# Neon (production):
#   DATABASE_URL — the POOLED endpoint (host contains "-pooler"). Used at
#     runtime; serverless functions open many short-lived connections.
#   DIRECT_URL   — the UNPOOLED endpoint. Used only by `prisma migrate`,
#     which needs DDL and advisory locks that PgBouncer can't proxy.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/formhub?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/formhub?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Auth (NextAuth v5)
# ─────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
# Public origin of this app. Used for invite links and the form endpoint URLs
# shown in the console — must be the real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

# ─────────────────────────────────────────────────────────────
# Secret encryption (AES-256-GCM)
# ─────────────────────────────────────────────────────────────
# Encrypts per-agency SMTP passwords, Turnstile secrets and webhook secrets.
# MUST be 32 bytes, base64-encoded:  openssl rand -base64 32
# Changing this without re-encrypting existing rows makes them unreadable.
ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────
# Platform SMTP (default transport; agencies may override per-agency)
# ─────────────────────────────────────────────────────────────
# Local dev: Mailpit via `docker compose up -d mailpit` (UI on :8025)
# Production: any SMTP provider. Port 587 => SMTP_SECURE=false (STARTTLS),
# port 465 => SMTP_SECURE=true.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# The sending domain needs SPF, DKIM and DMARC — this address sends on behalf
# of every agency, so its reputation is shared.
SMTP_FROM="FormHub <no-reply@example.com>"

# ─────────────────────────────────────────────────────────────
# Delivery scheduler
# ─────────────────────────────────────────────────────────────
# Vercel Cron is NOT used — the Hobby plan allows only one run per day. An
# external scheduler calls /api/cron/deliver instead.

# Accepted by /api/cron/deliver as `Authorization: Bearer <value>`.
# Used by any scheduler that isn't QStash, and for manual runs.
# openssl rand -hex 32
CRON_SECRET=""

# Upstash QStash — the recommended scheduler. https://console.upstash.com/qstash
# Mind the daily message quota when choosing an interval: */5 is ~288 calls/day.
# `npm run qstash:setup` prints the projected volume and refuses to exceed it.
# QSTASH_TOKEN is only needed to CREATE the schedule (npm run qstash:setup);
# the two signing keys are what the endpoint verifies incoming requests with,
# and both must be set in production so key rotation doesn't cause an outage.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (file uploads) — only needed once uploads are enabled
# ─────────────────────────────────────────────────────────────
# From the R2 dashboard: account id, plus an API token scoped to the bucket
# with "Object Read & Write". The bucket stays PRIVATE — files are served
# through short-lived presigned URLs, never public links.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Local dev only: point the S3 client at MinIO (docker compose up -d minio)
# instead of Cloudflare. Leave UNSET in production.
# R2_ENDPOINT="http://localhost:9100"
